{
  "name": "opendocs-extension",
  "version": "1.0.5",
  "private": true,
  "description": "Publish ChatGPT, Claude and Gemini answers and chats as OpenDocs documents: a clean link and a PDF.",
  "license": "MIT",
  "author": "OpenDocs <hello@opendocs.cc> (https://opendocs.cc)",
  "homepage": "https://opendocs.cc/extension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opendocs-cc/opendocs-extension.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/render-icons.mjs",
    "release:chrome": "OPENDOCS_STORE_BUILD=1 wxt zip",
    "release:edge": "OPENDOCS_STORE_BUILD=1 wxt zip -b edge"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wxt": "^0.21.5"
  }
}
