# Point a development build at a local OpenDocs stack (copy to .env.local).
# Without these, builds talk to opendocs.cc.
WXT_OPENDOCS_WEB_URL=http://localhost:3150
WXT_OPENDOCS_API_URL=http://localhost:4150
# Locally, Better Auth only accepts https client metadata URLs, so register a
# client (see README) and put its client_id here.
WXT_OPENDOCS_CLIENT_ID=
# The MCP resource the local web app issues tokens for (MCP_RESOURCE_URL).
WXT_OPENDOCS_RESOURCE=http://localhost:4160/mcp
